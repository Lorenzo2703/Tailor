# Copy to .env.local and fill in. Never commit real values.
# Local values are printed by `supabase status` (run it in WSL after `supabase start`).

# Supabase (public: safe for the browser, access is enforced by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site origin, used for email and OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (dev: use the always-pass test keys from the Cloudflare docs)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate limiting (required in production: requests are refused without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google sign-in: set to true only after enabling [auth.external.google] in supabase/config.toml
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Read by the Supabase CLI, not by Next.js
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server-only (never NEXT_PUBLIC_): reads notification recipients
SUPABASE_SERVICE_ROLE_KEY=
# Email notifications (Resend); optional in dev (emails are logged)
RESEND_API_KEY=
EMAIL_FROM=

# ── Observability (M14) ───────────────────────────────────────────────────────
# Sentry DSN — server-only, never expose to client
SENTRY_DSN=
# App environment label sent to Sentry
NEXT_PUBLIC_APP_ENV=development

# PostHog EU analytics — only sent after user consents (cookie banner)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# E2E tests (Playwright)
PLAYWRIGHT_BASE_URL=http://localhost:3000
